# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/dues_payment_system

# 32+ character secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Hubtel (Receive Money / Checkout) — optional until Phase 1's payment integration
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_POS_SALES_ID=
HUBTEL_WEBHOOK_SECRET=

# Bootstrap Super Admin — used only by `npm run db:seed` on first run
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
